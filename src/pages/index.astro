---
import Base from '../layouts/Base.astro';
import { TOOLS, COMING_SOON } from '../lib/tools';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Bitcoin Tools — simple, private, plain-English Bitcoin tools" description="Free Bitcoin tools explained in plain English: fee checker, stuck transaction helper, address checker, transaction explainer, sats converter and quantum exposure checker. No tracking, runs in your browser.">
  <h1>Bitcoin tools, in plain English.</h1>
  <p class="lead">Check fees, rescue a stuck payment, verify an address, or understand any transaction — without needing to be an expert. Everything runs in your browser. No accounts, no tracking, never any keys.</p>
  <div class="grid">
    {TOOLS.map((t) => <a class="card" href={`${base}tools/${t.slug}/`}><span class="icon" aria-hidden="true">{t.icon}</span><h2>{t.name}</h2><p>{t.blurb}</p></a>)}
  </div>
  <h2>Coming soon</h2>
  <ul class="muted">{COMING_SOON.map((c) => <li>{c}</li>)}</ul>
  <p class="note">Live data (fees, transactions, prices) comes from the public <a href="https://mempool.space">mempool.space</a> API, only when you ask for it. <a href={`${base}privacy/`}>Read exactly what is sent.</a></p>
</Base>
