---
/** Network picker for tools that read mempool.space. State lives in ?network= so links are shareable. */
---
<div class="net-pick">
  <label for="net-select" class="small">Network</label>
  <select id="net-select">
    <option value="mainnet">Mainnet (real bitcoin)</option>
    <option value="testnet4">Testnet4 (test coins)</option>
    <option value="signet">Signet (test coins)</option>
  </select>
  <p id="net-banner" class="small" role="status" hidden></p>
</div>
<script>import '../scripts/net.ts';</script>
